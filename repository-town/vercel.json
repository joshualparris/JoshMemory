{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run build:release",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/npc-chat.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
